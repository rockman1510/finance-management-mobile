<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Chụp ảnh hóa đơn để đính kèm vào giao dịch.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Chọn ảnh hóa đơn để đính kèm vào giao dịch.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Dùng Face ID để mở khóa ứng dụng.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Allows http://localhost:8080 for the local backend; production uses HTTPS only. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
